# =============================================================================
# LGTM Stack Environment Variables
# Add these to your .env file or use as .env.monitoring
# =============================================================================

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-password-here
GRAFANA_ROOT_URL=http://your-vps-ip:3000

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=barbod-gateway
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=production

# For Python services (Face Verification, OCR)
OTEL_PYTHON_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOG_LEVEL=INFO

# Loki Configuration
LOKI_URL=http://loki:3100

# Tempo Configuration  
TEMPO_URL=http://tempo:3200

# Prometheus Configuration
PROMETHEUS_URL=http://prometheus:9090
